+std::vector<G4String> SplitCSVLine(const G4String& line)
+{
+  std::vector<G4String> out;
+  G4String cell;
+  bool inQuotes = false;
+  for(char ch : line) {
+    if(ch == '"') {
+      inQuotes = !inQuotes;
+    } else if(ch == ',' && !inQuotes) {
+      out.push_back(cell);
+      cell.clear();
+    } else {
+      cell.push_back(ch);
+    }
+  }
+  out.push_back(cell);
+  return out;
+}
